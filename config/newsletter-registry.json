    "auto_discovered": {
      "description": "New senders detected in the inbox sweep, pending triage.",
      "sources": []
    }
  },
  "excluded": {
    "description": "Sender patterns the ingest pipeline skips entirely (promos, receipts, account notifications).",
    "senders": [
      { "sender_match": "receipts@examplestore.example", "reason": "transactional" },
      { "sender_match": "no-reply@exampleapp.example", "reason": "account notifications" }
    ]
  }
